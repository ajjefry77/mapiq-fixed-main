# Public frontend configuration. Do not put backend secrets in VITE_* variables.
VITE_GEOSERVER=https://your-geoserver.example.com
VITE_GEOSERVER_WORKSPACE=Amlak
VITE_SERVER=http://localhost:3002
VITE_MAPBOX_TOKEN=replace-with-a-restricted-public-mapbox-token
VITE_WFS_MAX_FEATURES=5000

# ---------- Logging / Observability (optional, safe to set in CI too) ----------
# Deployment environment used by the logger ("development" | "test" | "staging" | "production").
# When unset, Vite's MODE is used (dev server => development, build => production).
VITE_APP_ENV=development
# Build version baked into every log entry (e.g. set by CI: $CI_COMMIT_SHORT_SHA).
VITE_APP_VERSION=dev
# Master switch for the whole logging pipeline (default: true).
VITE_LOG_ENABLED=true
# Minimum level: trace | debug | info | warn | error | fatal.
# Defaults: development=trace/debug, test/staging=info, production=warn.
# VITE_LOG_LEVEL=debug
# Remote ingest endpoint (your log collector). When empty, remote + error transports
# are disabled automatically and everything stays on the console/devtools.
VITE_LOG_ENDPOINT=https://logs.example.com/api/logs
# Enable batched remote log shipping (default: true when VITE_LOG_ENDPOINT is set).
VITE_REMOTE_LOGGING_ENABLED=true
# Enable dedicated ERROR/FATAL pipeline to the same endpoint (default: true with endpoint).
VITE_ERROR_REPORTING_ENABLED=true
# Sampling probability 0..1 for high-volume (below WARN) events (default: 1).
VITE_LOG_SAMPLE_RATE=1
# Remote batching: logs per HTTP request (default: 10).
VITE_LOG_BATCH_SIZE=10
# Remote flush interval in ms (default: 5000).
VITE_LOG_FLUSH_INTERVAL=5000
# Max entries kept in the offline queue before oldest is dropped (default: 200).
VITE_LOG_MAX_QUEUE_SIZE=200
# Max network retries per batch with exponential backoff (default: 3).
VITE_LOG_MAX_RETRIES=3
# Dedupe window in ms + max occurrences per window for identical errors (default: 60000/10).
VITE_LOG_DEDUPE_WINDOW=60000
VITE_LOG_DEDUPE_MAX=10
# Sanitizer limits (default depth 6, entries 200) — protects against huge GIS geometry.
VITE_LOG_MAX_DEPTH=6
VITE_LOG_MAX_ENTRIES=200
# Persist logs offline and retry when connectivity returns (default: true).
VITE_LOG_OFFLINE_QUEUE=true

# Backend-only secrets must be supplied by the server/deployment secret manager.
# JWT_SECRET=
# JWT_EXPIRES_IN=7d
# ENCRYPTION_KEY=
# DEFAULT_ADMIN_PHONE=
# DEFAULT_ADMIN_PASSWORD=
PORT=3002
